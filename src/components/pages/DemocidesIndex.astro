---
import type { Lang } from '../../lib/i18n';
import { t, localizedHref } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import TrailNav from '../TrailNav.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const href = (slug: string) => `${base}${localizedHref(slug, lang)}`;

const cases = [
	{ regimeKey: 'democides.regime.soviets', period: '1917–1987', deaths: '61,9M',
		slug: 'socialismo', highlights: ['Gulag', 'Holodomor', 'Grande Terror', 'Deportações em massa'],
		descKey: 'democides.case.soviets.desc', tagKey: 'democides.tag.socialism' },
	{ regimeKey: 'democides.regime.china', period: '1949–1976', deaths: '76,7M',
		slug: 'socialismo', highlights: ['Grande Salto Adiante', 'Revolução Cultural', 'Reforma agrária'],
		descKey: 'democides.case.china.desc', tagKey: 'democides.tag.socialism' },
	{ regimeKey: 'democides.regime.nazism', period: '1933–1945', deaths: '20,9M',
		slug: 'nazismo', highlights: ['Holocausto', 'Programa T4', 'Prisioneiros soviéticos', 'Trabalho forçado'],
		descKey: 'democides.case.nazism.desc', tagKey: 'democides.tag.nazism' },
	{ regimeKey: 'democides.regime.kmt', period: '1928–1949', deaths: '10,2M',
		slug: null, highlights: ['Guerras civis', 'Execuções políticas', 'Fome de 1942–43'],
		descKey: 'democides.case.kmt.desc', tagKey: 'democides.tag.dictatorship' },
	{ regimeKey: 'democides.regime.japan', period: '1900–1945', deaths: '5,9M',
		slug: null, highlights: ['Nanquim', 'Manchúria', 'Filipinas', 'Prisioneiros de guerra'],
		descKey: 'democides.case.japan.desc', tagKey: 'democides.tag.militarism' },
	{ regimeKey: 'democides.regime.cambodia', period: '1975–1979', deaths: '2,0M',
		slug: 'socialismo', highlights: ['Evacuação forçada', 'Campos de trabalho', 'S-21', 'Campos da morte'],
		descKey: 'democides.case.cambodia.desc', tagKey: 'democides.tag.socialism' },
	{ regimeKey: 'democides.regime.turkey', period: '1900–1923', deaths: '1,9M',
		slug: null, highlights: ['Genocídio Armênio', 'Gregos e Assírios', 'Marchas da morte'],
		descKey: 'democides.case.turkey.desc', tagKey: 'democides.tag.ethnonationalism' },
	{ regimeKey: 'democides.regime.colonies', period: '1900–1960', deaths: '~870K',
		slug: 'colonialismo', highlights: ['Congo Belga', 'África do Sudoeste Alemã', 'Índia Britânica', 'Fomes coloniais'],
		descKey: 'democides.case.colonies.desc', tagKey: 'democides.tag.colonialism' },
	{ regimeKey: 'democides.regime.latins', period: '1960–1990', deaths: '~300K',
		slug: 'ditaduras-latinas', highlights: ['Argentina', 'Chile', 'Guatemala', 'Brasil'],
		descKey: 'democides.case.latins.desc', tagKey: 'democides.tag.authoritarianism' },
];
---

<Layout
	title={`${t('democides.h1', lang)} | ${t('site.title', lang)}`}
	description={t('democides.intro', lang)}
	lang={lang}
	currentPath="democidios/"
>

	<TrailNav current={3} position="top" lang={lang} />

	<header class="page-header">
		<h1>{t('democides.h1', lang)}</h1>
		<p class="intro">{t('democides.intro', lang)}</p>
	</header>

	<div class="cases-grid">
		{cases.map((entry) => (
			<div class={`case-card ${entry.slug ? 'case-card--linked' : ''}`}>
				<div class="case-top">
					<div class="case-deaths">
						<span class="deaths-num">{entry.deaths}</span>
						<span class="deaths-label">{t('common.deaths.label', lang)}</span>
					</div>
					<span class="case-tag">{t(entry.tagKey, lang)}</span>
				</div>
				<h3 class="case-regime">{t(entry.regimeKey, lang)}</h3>
				<p class="case-period">{entry.period}</p>
				<p class="case-desc">{t(entry.descKey, lang)}</p>
				<ul class="case-highlights">
					{entry.highlights.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				{entry.slug && (
					<a href={href(`democidios/${entry.slug}/`)} class="case-link">
						{t('common.see.analysis', lang)}
					</a>
				)}
			</div>
		))}
	</div>

	<div class="total-bar">
		<span class="total-label kicker">{t('democides.total.label', lang)}</span>
		<span class="total-num">{t('democides.total.num', lang)}</span>
	</div>

	<TrailNav current={3} position="bottom" lang={lang} />

</Layout>

<style>
	.page-header { margin-bottom: 2.5rem; }
	h1 { font-family: var(--display); font-size: clamp(2.2rem, 6vw, 3.8rem); font-weight: 900; font-style: italic; margin: 0.2rem 0 0.75rem; line-height: 1.05; letter-spacing: -0.02em; }
	.intro { max-width: 58ch; color: var(--muted); line-height: 1.65; margin: 0 0 1.5rem; font-size: 1rem; }

	.cases-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border: 1px solid var(--rule-strong); border-radius: 3px; overflow: hidden; background: var(--rule-strong); margin-bottom: 1px; }
	.case-card { padding: 1.5rem; background: rgba(255, 252, 240, 0.9); display: flex; flex-direction: column; }
	.case-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.85rem; }
	.case-deaths { display: flex; flex-direction: column; }
	.deaths-num { font-family: var(--display); font-size: 1.8rem; font-weight: 900; color: var(--accent); line-height: 1; }
	.deaths-label { font-family: var(--mono); font-size: 0.58rem; color: var(--faint); letter-spacing: 0.05em; text-transform: uppercase; margin-top: 0.2rem; }
	.case-tag { font-family: var(--mono); font-size: 0.6rem; color: var(--muted); border: 1px solid var(--rule-strong); border-radius: 2px; padding: 0.15rem 0.45rem; letter-spacing: 0.03em; }
	.case-regime { font-family: var(--display); font-size: 1.05rem; font-weight: 700; color: var(--ink); margin: 0 0 0.2rem; line-height: 1.2; }
	.case-period { font-family: var(--mono); font-size: 0.65rem; color: var(--faint); margin: 0 0 0.7rem; letter-spacing: 0.03em; }
	.case-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.55; margin: 0 0 0.85rem; flex: 1; }
	.case-highlights { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.3rem; }
	.case-highlights li { font-family: var(--mono); font-size: 0.6rem; color: var(--muted); border: 1px solid var(--rule); border-radius: 2px; padding: 0.12rem 0.4rem; letter-spacing: 0.02em; }
	.case-link { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--accent); text-decoration: none; margin-top: auto; }
	.case-link:hover { text-decoration: underline; }

	.total-bar { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; border: 1px solid var(--rule-strong); border-radius: 0 0 3px 3px; background: rgba(122, 46, 31, 0.06); gap: 1rem; flex-wrap: wrap; }
	.total-label { margin: 0; }
	.total-num { font-family: var(--display); font-size: 1.2rem; font-weight: 900; color: var(--accent); letter-spacing: -0.01em; }

	@media (max-width: 900px) { .cases-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 580px) { .cases-grid { grid-template-columns: 1fr; } }
</style>

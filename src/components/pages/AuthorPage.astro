---
import type { Lang } from '../../lib/i18n';
import { t, localizedHref } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import TrilhaNav from '../TrilhaNav.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const href = (slug: string) => `${base}${localizedHref(slug, lang)}`;
---

<Layout
	title={`${t('autor.h1', lang)} | ${t('site.title', lang)}`}
	description={t('autor.subtitle', lang)}
	lang={lang}
	currentPath="autor/"
>
	<TrilhaNav current={1} position="top" lang={lang} />
	<div class="page-layout">
		<div class="content">

			<header class="page-header">
				<h1>{t('autor.h1', lang)}</h1>
				<p class="subtitle">{t('autor.subtitle', lang)}</p>
			</header>

			<div class="prose-section">
				<h2>{t('autor.trajectory.h2', lang)}</h2>
				<p>{t('autor.trajectory.p1', lang)}</p>
				<p>{t('autor.trajectory.p2', lang)}</p>
				<p>{t('autor.trajectory.p3', lang)}</p>
			</div>

			<div class="prose-section">
				<h2>{t('autor.contribution.h2', lang)}</h2>
				<p set:html={t('autor.contribution.p1', lang)} />
				<p set:html={t('autor.contribution.p2', lang)} />
				<p>{t('autor.contribution.p3', lang)}</p>
			</div>

			<div class="prose-section">
				<h2>{t('autor.legacy.h2', lang)}</h2>
				<p>{t('autor.legacy.p1', lang)}</p>
				<p>{t('autor.legacy.p2', lang)}</p>
			</div>

		</div>

		<aside class="sidebar">
			<div class="sidebar-block">
				<p class="kicker">{t('autor.sidebar.works', lang)}</p>
				<p class="works-blurb" set:html={t('autor.sidebar.works.blurb', lang)} />
				<a href={href('preservation/')} class="works-link">{t('autor.sidebar.works.link', lang)}</a>
			</div>

			<div class="sidebar-block">
				<p class="kicker">{t('autor.sidebar.stats', lang)}</p>
				<div class="stat-list">
					<div class="stat">
						<span class="stat-num">262M</span>
						<span class="stat-label">{t('autor.stat1.label', lang)}</span>
					</div>
					<div class="stat">
						<span class="stat-num">40</span>
						<span class="stat-label">{t('autor.stat2.label', lang)}</span>
					</div>
					<div class="stat">
						<span class="stat-num">5</span>
						<span class="stat-label">{t('autor.stat3.label', lang)}</span>
					</div>
				</div>
			</div>
		</aside>
	</div>
	<TrilhaNav current={1} position="bottom" lang={lang} />
</Layout>

<style>
	.page-layout { display: grid; grid-template-columns: 1fr 280px; gap: 4rem; align-items: start; }
	.page-header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); }
	h1 { font-family: var(--display); font-size: clamp(2.2rem, 6vw, 3.8rem); font-weight: 900; font-style: italic; margin: 0.2rem 0 0.4rem; line-height: 1.05; letter-spacing: -0.02em; }
	.subtitle { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); letter-spacing: 0.04em; margin: 0; }

	.prose-section { margin-bottom: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--rule); }
	.prose-section:last-child { border-bottom: none; margin-bottom: 0; }
	h2 { font-family: var(--display); font-size: 1.2rem; font-weight: 700; margin: 0 0 0.9rem; color: var(--ink); }
	.prose-section p { font-size: 1.05rem; line-height: 1.78; color: var(--ink); margin: 0 0 1em; max-width: 65ch; }
	.prose-section p:last-child { margin: 0; }
	.prose-section :global(strong) { font-weight: 600; }

	.sidebar { position: sticky; top: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
	.sidebar-block { padding: 1.25rem 1.5rem; border: 1px solid var(--rule-strong); border-radius: 3px; background: rgba(255, 252, 240, 0.85); }
	.sidebar-block .kicker { margin-bottom: 0.85rem; }

	.works-blurb { font-size: 0.82rem; color: var(--muted); line-height: 1.55; margin: 0 0 0.85rem; }
	.works-blurb :global(em) { font-style: italic; color: var(--ink); }
	.works-link { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.04em; color: var(--accent); text-decoration: none; display: inline-block; }
	.works-link:hover { text-decoration: underline; }

	.stat-list { display: flex; flex-direction: column; gap: 0.85rem; }
	.stat { display: flex; align-items: baseline; gap: 0.75rem; }
	.stat-num { font-family: var(--display); font-size: 1.6rem; font-weight: 900; color: var(--accent); line-height: 1; flex-shrink: 0; }
	.stat-label { font-family: var(--mono); font-size: 0.65rem; color: var(--muted); letter-spacing: 0.03em; line-height: 1.4; }

	@media (max-width: 860px) {
		.page-layout { grid-template-columns: 1fr; }
		.sidebar { position: static; }
	}
</style>

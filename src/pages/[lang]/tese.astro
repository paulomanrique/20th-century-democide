---
import { LANGUAGES, DEFAULT_LANG } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';
import ThesisPage from '../../components/pages/ThesisPage.astro';

export function getStaticPaths() {
	return LANGUAGES.filter((l) => l.code !== DEFAULT_LANG).map((l) => ({
		params: { lang: l.code },
	}));
}

const { lang } = Astro.params as { lang: Lang };
---
<ThesisPage lang={lang} />

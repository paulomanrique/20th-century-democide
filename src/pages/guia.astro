---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { displayTitle } from '../lib/title';

const items = await getCollection('items', ({ data }) => !data.draft);
const toBase = (target = '') => `${import.meta.env.BASE_URL}${target.replace(/^\/+/, '')}`;

function getItem(id: string) {
	const entry = items.find((e) => e.id === id);
	return entry ? { id: entry.id, title: displayTitle(entry.data.title, entry.id) } : null;
}

const sections = [
	{
		num: '01',
		slug: 'o-autor',
		titleKey: 'guide.s1.title',
		title: 'O Autor',
		subtitleKey: 'guide.s1.subtitle',
		subtitle: 'Quem foi R.J. Rummel?',
		bodyKey: 'guide.s1.body',
		itemIds: [
			'death-by-government',
			'statistics-of-democide-note',
			'chinas-bloody-century-note',
			'lethal-politics-note',
		],
	},
	{
		num: '02',
		slug: 'o-que-e-democidio',
		titleKey: 'guide.s2.title',
		title: 'O Que É Democídio',
		subtitleKey: 'guide.s2.subtitle',
		subtitle: 'Definindo o termo',
		bodyKey: 'guide.s2.body',
		itemIds: [
			'definition-and-qualifications',
			'democide-versus-genocide',
			'what-is-genocide',
			'death-by-government-chapter-1',
		],
	},
	{
		num: '03',
		slug: 'a-escala',
		titleKey: 'guide.s3.title',
		title: 'A Escala',
		subtitleKey: 'guide.s3.subtitle',
		subtitle: 'A magnitude do achado',
		bodyKey: 'guide.s3.body',
		itemIds: [
			'20th-century-democide',
			'war-isnt-this-centurys-biggest-killer',
			'death-by-government-chapter-1',
			'democide-summary-by-regime-table',
		],
	},
	{
		num: '04',
		slug: 'os-casos',
		titleKey: 'guide.s4.title',
		title: 'Os Casos',
		subtitleKey: 'guide.s4.subtitle',
		subtitle: 'Regime a regime',
		bodyKey: 'guide.s4.body',
		itemIds: [
			'how-many-did-communism-murder',
			'american-bombing-and-other-democide',
			'holocaust-in-comparative-perspective',
			'reevaluating-chinas-democide',
			'reevaluating-colonial-democide',
			'centi-kilo-murderers',
			'lesser-murderers',
			'khmer-rouge-and-rwandan-genocide-section',
		],
	},
	{
		num: '05',
		slug: 'a-analise',
		titleKey: 'guide.s5.title',
		title: 'A Análise',
		subtitleKey: 'guide.s5.subtitle',
		subtitle: 'O que os dados mostram',
		bodyKey: 'guide.s5.body',
		itemIds: [
			'social-field-of-democide',
			'democide-since-world-war-ii',
			'statistics-of-democide-notes',
			'statistics-of-democide-sources',
		],
	},
	{
		num: '06',
		slug: 'a-tese',
		titleKey: 'guide.s6.title',
		title: 'A Tese',
		subtitleKey: 'guide.s6.subtitle',
		subtitle: 'Poder mata — e o que decorre disso',
		bodyKey: 'guide.s6.body',
		itemIds: [
			'murder',
			'miracle',
			'theory',
			'policy',
			'democide-versus-genocide',
		],
	},
];

const fallbackBodies: Record<string, string> = {
	'guide.s1.body': 'R.J. Rummel (1932–2014) foi um cientista político da Universidade do Havaí que passou quarenta anos quantificando o assassinato patrocinado por governos. É creditado por cunhar o termo <em>democídio</em> e por produzir o registro estatístico mais abrangente de assassinatos em massa cometidos por Estados na era moderna. Suas obras principais — <em>Death by Government</em>, <em>Statistics of Democide</em>, <em>China\'s Bloody Century</em> e <em>Lethal Politics</em> — formam o corpus preservado neste arquivo.',
	'guide.s2.body': 'Rummel definiu democídio como <em>"o assassinato de qualquer pessoa ou povo pelo seu próprio governo, incluindo genocídio, politicídio e assassinato em massa."</em> A definição foi desenhada para capturar o ato letal estatal que fica fora do combate — execuções, fomes engendradas, mortes por trabalho forçado e bombardeio deliberado de civis. A distinção do genocídio importa: o democídio não exige intenção de destruir um grupo enquanto tal, apenas que o governo mate intencionalmente. Esse enquadramento mais amplo revelou uma categoria de violência política que vinha sendo sistematicamente subcontada.',
	'guide.s3.body': 'O achado central de Rummel é que governos mataram aproximadamente <strong>262&nbsp;milhões de pessoas</strong> no século XX — quase quatro vezes o total de mortes em todas as guerras do mesmo período. Ele chamou de <em>"megamurderers"</em> os regimes que mataram mais de um milhão. A União Soviética lidera suas estimativas com cerca de 62&nbsp;milhões; a China nacionalista e a comunista vêm em seguida; Alemanha nazista, Japão Imperial e a China nacionalista compõem o segundo escalão. O restante — dezenas de regimes menores — soma dezenas de milhões a mais.',
	'guide.s4.body': 'Rummel produziu estudos estatísticos detalhados de dezenas de regimes, apresentando estimativas de fontes primárias, seus próprios cálculos e faixas consolidadas com documentação completa. Os estudos vão dos megamurderers a democídios coloniais e em tempo de guerra pouco conhecidos, raramente presentes na historiografia convencional. Cada capítulo segue o mesmo método — permitindo comparação direta entre casos que de outra forma são tratados isoladamente.',
	'guide.s5.body': 'Rummel analisou o democídio estatisticamente, tratando-o como variável dependente ao lado de sistemas políticos, desenvolvimento econômico, diversidade cultural e conflito militar. O achado consistente em dezenas de análises: o poder político — especificamente sua concentração e ausência de freios — é o preditor dominante do democídio. A guerra correlaciona com o democídio mas não o causa independentemente do poder. As análises de campo social formalizam essa relação com análises fatoriais, correlações canônicas e modelos de regressão.',
	'guide.s6.body': 'O argumento central que Rummel extraiu de seus dados está capturado na frase <em>"poder mata; poder absoluto mata absolutamente."</em> Estados governados democraticamente — onde o poder é limitado, fiscalizado e accountable — praticamente nunca cometem democídio contra seu próprio povo. Rummel sustentava que esse era o achado mais robusto de sua pesquisa e a conclusão mais acionável: difundir a democracia e limitar o poder do Estado é a prevenção mais eficaz contra o assassinato em massa. É o que ele chamou de <em>"milagre"</em> — que a solução já era conhecida.',
};
---

<Layout title="Comece aqui | 20th Century Democide" description="Uma trilha curada pela obra de R.J. Rummel sobre democídio — da biografia à tese central, com links para as fontes primárias preservadas.">

	<header class="guide-header">
		<a href={toBase()} class="back-link" data-i18n="guide.back">← Início</a>
		<p class="kicker" data-i18n="guide.kicker">Trilha de leitura</p>
		<h1 data-i18n="guide.h1">Seis capítulos pela obra de Rummel</h1>
		<p class="guide-intro" data-i18n="guide.intro">
			Este guia te leva da biografia de Rummel à sua tese central, em ordem. Cada seção
			apresenta o contexto e linka para os textos originais preservados. Leia o
			enquadramento aqui, depois siga os links para as fontes primárias.
		</p>
		<nav class="guide-toc">
			{sections.map((s) => (
				<a href={`#${s.slug}`} class="toc-item">
					<span class="toc-num">{s.num}</span>
					<span class="toc-title" data-i18n={s.titleKey}>{s.title}</span>
				</a>
			))}
		</nav>
	</header>

	<div class="guide-body">
		{sections.map((section) => {
			const linkedItems = section.itemIds.map(getItem).filter(Boolean);
			return (
				<section class="guide-section" id={section.slug}>
					<div class="section-header">
						<span class="section-num">{section.num}</span>
						<div>
							<h2 class="section-title" data-i18n={section.titleKey}>{section.title}</h2>
							<p class="section-subtitle" data-i18n={section.subtitleKey}>{section.subtitle}</p>
						</div>
					</div>
					<div class="section-body">
						<div class="section-text" data-i18n={section.bodyKey} data-i18n-html set:html={fallbackBodies[section.bodyKey]} />
						{linkedItems.length > 0 && (
							<div class="section-links">
								<p class="links-label kicker" data-i18n="guide.primarySources">Fontes primárias</p>
								<ul class="source-list">
									{linkedItems.map((item) => item && (
										<li>
											<a href={toBase(`items/${item.id}/`)}>{item.title}</a>
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</section>
			);
		})}
	</div>

	<div class="guide-footer">
		<p data-i18n="guide.footer.p">Todos os textos linkados acima são cópias preservadas da obra original de Rummel. Nada foi editado ou interpretado além do que aparece nesta página.</p>
		<a href={toBase('collections/')} data-i18n="guide.footer.link">Explorar todas as coleções →</a>
	</div>

</Layout>

<style>
	.guide-header { padding-bottom: 2.5rem; margin-bottom: 0; border-bottom: 1px solid var(--rule-strong); }
	.back-link { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em; color: var(--muted); text-decoration: none; display: inline-block; margin-bottom: 1.5rem; }
	.back-link:hover { color: var(--accent); }
	h1 { font-family: var(--display); font-size: clamp(1.8rem, 5vw, 3rem); font-weight: 900; font-style: italic; margin: 0.2rem 0 0.9rem; line-height: 1.1; letter-spacing: -0.02em; }
	.guide-intro { max-width: 58ch; color: var(--muted); line-height: 1.7; margin: 0 0 2rem; font-size: 1rem; }

	.guide-toc { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.toc-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.85rem 0.4rem 0.6rem; border: 1px solid var(--rule-strong); border-radius: 2px; text-decoration: none; background: rgba(255, 252, 240, 0.8); transition: background 0.12s, border-color 0.12s; }
	.toc-item:hover { background: var(--accent-pale); border-color: var(--accent); }
	.toc-num { font-family: var(--mono); font-size: 0.6rem; color: var(--faint); letter-spacing: 0.05em; }
	.toc-title { font-size: 0.85rem; font-weight: 600; color: var(--ink); }

	.guide-body { border-left: 1px solid var(--rule); margin-left: 1.5rem; }
	.guide-section { display: grid; grid-template-columns: 1fr; padding: 3rem 0 3rem 2.5rem; border-bottom: 1px solid var(--rule); position: relative; }
	.guide-section::before { content: ''; position: absolute; left: -5px; top: 3.4rem; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 2px solid var(--rule-strong); }
	.guide-section:first-child::before { border-color: var(--accent); background: var(--accent); }
	.guide-section:last-child { border-bottom: none; }

	.section-header { display: flex; align-items: flex-start; gap: 1.25rem; margin-bottom: 1.25rem; }
	.section-num { font-family: var(--mono); font-size: 0.65rem; color: var(--faint); letter-spacing: 0.08em; padding-top: 0.35rem; flex-shrink: 0; min-width: 1.5rem; }
	.section-title { font-family: var(--display); font-size: 1.5rem; font-weight: 700; margin: 0 0 0.2rem; color: var(--ink); line-height: 1.2; }
	.section-subtitle { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); letter-spacing: 0.04em; margin: 0; }

	.section-body { display: grid; grid-template-columns: 1fr 280px; gap: 2.5rem; align-items: start; }
	.section-text { font-size: 1.02rem; line-height: 1.75; color: var(--ink); max-width: 60ch; }
	.section-text em { font-style: italic; }
	.section-text strong { font-weight: 600; }

	.section-links { padding: 1rem 1.25rem; border: 1px solid var(--rule); border-radius: 3px; background: rgba(255, 252, 240, 0.6); }
	.links-label { margin: 0 0 0.6rem; }
	.source-list { list-style: none; padding: 0; margin: 0; }
	.source-list li { padding: 0.45rem 0; border-bottom: 1px solid var(--rule); }
	.source-list li:last-child { border-bottom: none; }
	.source-list a { font-size: 0.82rem; color: var(--muted); text-decoration: none; display: block; line-height: 1.4; }
	.source-list a:hover { color: var(--accent); }

	.guide-footer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--rule-strong); text-align: center; }
	.guide-footer p { font-size: 0.9rem; color: var(--muted); max-width: 56ch; margin: 0 auto 1rem; line-height: 1.6; }
	.guide-footer a { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em; color: var(--accent); text-decoration: none; }
	.guide-footer a:hover { text-decoration: underline; }

	@media (max-width: 760px) {
		.section-body { grid-template-columns: 1fr; }
		.guide-body { margin-left: 0.75rem; }
		.guide-section { padding-left: 1.5rem; }
	}
</style>

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { displayTitle } from '../../lib/title';

const items = await getCollection('items', ({ data }) => !data.draft);
const toBase = (target = '') => `${import.meta.env.BASE_URL}${target.replace(/^\/+/, '')}`;
function link(id: string) {
	const e = items.find((i) => i.id === id);
	return e ? { id: e.id, title: displayTitle(e.data.title, e.id) } : null;
}
const fontes = [
	link('how-many-did-communism-murder'),
	link('lethal-politics-note'),
	link('reevaluating-chinas-democide'),
	link('chinas-bloody-century-note'),
	link('khmer-rouge-and-rwandan-genocide-section'),
].filter(Boolean);

const casos = [
	{
		pais: 'União Soviética',
		mortes: '61,9M',
		periodo: '1917–1987',
		eventos: [
			{ nome: 'Gulag', mortes: '~39M', desc: 'O sistema de campos de trabalho forçado que Rummel estima ter ceifado cerca de 39 milhões de vidas entre execuções, mortes por condições de trabalho e deportações.' },
			{ nome: 'Holodomor', mortes: '~5M', desc: 'A fome forçada na Ucrânia de 1932–1933. Rummel a classifica como democídio intencional: o Estado confiscou a produção de alimentos sabendo que a população morreria.' },
			{ nome: 'Grande Terror', mortes: '~750K diretas', desc: 'As purgas stalinistas de 1936–1938. Cerca de 750 mil execuções documentadas, mais centenas de milhares de mortes nos campos.' },
			{ nome: 'Deportações em massa', mortes: 'Centenas de milhares', desc: 'Chechenos, tártaros da Crimeia, alemães do Volga e outros povos inteiros deportados para a Sibéria em condições deliberadamente letais.' },
		],
	},
	{
		pais: 'China (Mao Tsé-Tung)',
		mortes: '76,7M',
		periodo: '1949–1976',
		eventos: [
			{ nome: 'Grande Salto Adiante', mortes: '~35–45M', desc: 'A fome de 1959–1961 causada pela coletivização forçada e pelas quotas de grãos que o Estado continuou exportando enquanto camponeses morriam. A maior fome da história humana.' },
			{ nome: 'Revolução Cultural', mortes: '~1–3M diretas', desc: 'A campanha de 1966–1976 que destruiu a classe intelectual chinesa, com execuções, suicídios e mortes nos campos de reeducação.' },
			{ nome: 'Reforma Agrária', mortes: '~1–2M', desc: 'A liquidação dos proprietários de terra após 1949, com julgamentos populares que terminavam em execução pública.' },
			{ nome: 'Laogai', mortes: 'Centenas de milhares', desc: 'O sistema de trabalho forçado chinês, análogo ao Gulag soviético, operando desde 1950.' },
		],
	},
	{
		pais: 'Camboja (Khmer Vermelho)',
		mortes: '2,0M',
		periodo: '1975–1979',
		eventos: [
			{ nome: 'Evacuação de Phnom Penh', mortes: 'Dezenas de milhares', desc: 'Em abril de 1975, toda a população de Phnom Penh (~2 milhões de pessoas) foi forçada a deixar a cidade em marchas letais.' },
			{ nome: 'Campos de trabalho forçado', mortes: 'Centenas de milhares', desc: 'A população foi redistribuída em "zonas cooperativas" com trabalho escravo, rações mínimas e execução por qualquer infração.' },
			{ nome: 'S-21 e campos da morte', mortes: '~17.000 em S-21', desc: 'O centro de detenção e tortura em Phnom Penh. Apenas sete prisioneiros sobreviveram. Os campos da morte (Choeung Ek) receberam os restos.' },
		],
	},
];
---

<Layout title="Socialismo | Democídios | 20th Century Democide" description="O democídio cometido por regimes comunistas — URSS, China, Camboja e outros.">
	<div class="page-layout">
		<div class="content">
			<nav class="breadcrumb">
				<a href={toBase('democidios/')}>Democídios</a>
				<span>›</span>
				<span>Socialismo</span>
			</nav>

			<header class="page-header">
				<h1>Socialismo</h1>
				<p class="subtitle">URSS · China · Camboja · Coreia do Norte</p>
				<p class="header-intro">
					Os regimes comunistas do século XX respondem pela maior parcela do democídio
					estimado por Rummel. Juntos, a União Soviética e a China comunista somam mais de
					138 milhões de mortes — mais da metade do total global.
				</p>
			</header>

			{casos.map((caso) => (
				<div class="country-section">
					<div class="country-header">
						<h2>{caso.pais}</h2>
						<div class="country-stats">
							<span class="cstat-num">{caso.mortes}</span>
							<span class="cstat-period">{caso.periodo}</span>
						</div>
					</div>
					<div class="events">
						{caso.eventos.map((ev) => (
							<div class="event">
								<div class="event-header">
									<span class="event-name">{ev.nome}</span>
									<span class="event-deaths">{ev.mortes}</span>
								</div>
								<p class="event-desc">{ev.desc}</p>
							</div>
						))}
					</div>
				</div>
			))}

			<div class="prose-section">
				<h2>A perspectiva de Rummel</h2>
				<p>
					Em <em>"How Many Did Communist Regimes Murder?"</em>, Rummel estima que regimes
					comunistas mataram entre 110 e 260 milhões de pessoas no século XX, com um valor
					central próximo de 110 milhões. A revisão de 2005 da estimativa chinesa elevou
					esse número significativamente.
				</p>
				<p>
					Rummel é cuidadoso em distinguir os mecanismos: não foi a ideologia socialista
					<em>per se</em> que produziu o democídio, mas a concentração absoluta de poder
					que esses regimes criaram. A coletivização forçada, o controle estatal da
					alimentação, a eliminação de toda oposição — esses são os mecanismos. A ideologia
					foi o pretexto que os legitimou.
				</p>
			</div>
		</div>

		<aside class="sidebar">
			<div class="sidebar-block sidebar-block--accent">
				<p class="kicker">Total combinado</p>
				<span class="big-num">~138M</span>
				<p class="big-num-label">URSS + China (estimativa Rummel)</p>
			</div>
			<div class="sidebar-block">
				<p class="kicker">Por regime</p>
				<ul class="breakdown">
					<li><span>União Soviética</span><span>61,9M</span></li>
					<li><span>China (Mao)</span><span>76,7M</span></li>
					<li><span>Camboja</span><span>2,0M</span></li>
					<li><span>Vietnã</span><span>1,7M</span></li>
					<li><span>Coreia do Norte</span><span>&gt;1M</span></li>
				</ul>
			</div>
			<div class="sidebar-block">
				<p class="kicker">Fontes primárias preservadas</p>
				<ul class="source-list">
					{fontes.map((item) => item && (
						<li><a href={toBase(`items/${item.id}/`)}>{item.title}</a></li>
					))}
				</ul>
			</div>
		</aside>
	</div>
</Layout>

<style>
	.page-layout { display: grid; grid-template-columns: 1fr 260px; gap: 4rem; align-items: start; }
	.breadcrumb { font-family: var(--mono); font-size: 0.68rem; color: var(--faint); margin-bottom: 1.5rem; display: flex; gap: 0.4rem; align-items: center; }
	.breadcrumb a { color: var(--muted); text-decoration: none; }
	.breadcrumb a:hover { color: var(--accent); }
	.page-header { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); }
	h1 { font-family: var(--display); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; font-style: italic; margin: 0 0 0.3rem; line-height: 1.05; letter-spacing: -0.02em; }
	.subtitle { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); letter-spacing: 0.04em; margin: 0 0 0.85rem; }
	.header-intro { font-size: 1rem; line-height: 1.7; color: var(--muted); max-width: 60ch; margin: 0; }

	/* Country sections */
	.country-section { margin-bottom: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--rule); }
	.country-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
	h2 { font-family: var(--display); font-size: 1.35rem; font-weight: 700; margin: 0; color: var(--ink); }
	.country-stats { text-align: right; }
	.cstat-num { display: block; font-family: var(--display); font-size: 1.5rem; font-weight: 900; color: var(--accent); line-height: 1; }
	.cstat-period { display: block; font-family: var(--mono); font-size: 0.62rem; color: var(--faint); letter-spacing: 0.04em; margin-top: 0.2rem; }

	.events { display: flex; flex-direction: column; gap: 1px; border: 1px solid var(--rule-strong); border-radius: 3px; overflow: hidden; background: var(--rule-strong); }
	.event { padding: 1rem 1.25rem; background: rgba(255,252,240,0.9); }
	.event-header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.4rem; }
	.event-name { font-weight: 600; font-size: 0.95rem; color: var(--ink); }
	.event-deaths { font-family: var(--mono); font-size: 0.68rem; color: var(--accent); letter-spacing: 0.03em; flex-shrink: 0; }
	.event-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.55; margin: 0; }

	.prose-section { margin-bottom: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--rule); }
	.prose-section:last-child { border-bottom: none; }
	.prose-section h2 { font-family: var(--display); font-size: 1.2rem; font-weight: 700; margin: 0 0 0.9rem; }
	.prose-section p { font-size: 1.05rem; line-height: 1.78; color: var(--ink); margin: 0 0 1em; max-width: 65ch; }
	.prose-section p:last-child { margin: 0; }
	.prose-section em { font-style: italic; }

	.sidebar { position: sticky; top: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
	.sidebar-block { padding: 1.25rem 1.5rem; border: 1px solid var(--rule-strong); border-radius: 3px; background: rgba(255,252,240,0.85); }
	.sidebar-block--accent { border-top: 3px solid var(--accent); }
	.sidebar-block .kicker { margin-bottom: 0.75rem; }
	.big-num { font-family: var(--display); font-size: 2.2rem; font-weight: 900; color: var(--accent); line-height: 1; display: block; }
	.big-num-label { font-family: var(--mono); font-size: 0.62rem; color: var(--muted); letter-spacing: 0.04em; margin-top: 0.2rem; display: block; }
	.breakdown { list-style: none; padding: 0; margin: 0; }
	.breakdown li { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.4rem 0; border-bottom: 1px solid var(--rule); font-size: 0.82rem; color: var(--muted); }
	.breakdown li:last-child { border-bottom: none; }
	.breakdown li span:last-child { font-family: var(--mono); font-size: 0.72rem; color: var(--accent); flex-shrink: 0; }
	.source-list { list-style: none; padding: 0; margin: 0; }
	.source-list li { padding: 0.4rem 0; border-bottom: 1px solid var(--rule); }
	.source-list li:last-child { border-bottom: none; }
	.source-list a { font-size: 0.85rem; color: var(--muted); text-decoration: none; display: block; line-height: 1.45; }
	.source-list a:hover { color: var(--accent); }

	@media (max-width: 860px) { .page-layout { grid-template-columns: 1fr; } .sidebar { position: static; } }
</style>

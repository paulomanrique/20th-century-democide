---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { displayTitle } from '../lib/title';

const items = await getCollection('items', ({ data }) => !data.draft);
const toBase = (target = '') => `${import.meta.env.BASE_URL}${target.replace(/^\/+/, '')}`;

function getItem(id: string) {
	const entry = items.find((e) => e.id === id);
	return entry ? { id: entry.id, title: displayTitle(entry.data.title, entry.id) } : null;
}

const sections = [
	{
		num: '01',
		slug: 'o-autor',
		title: 'O Autor',
		subtitle: 'Who was R.J. Rummel?',
		body: `R.J. Rummel (1932–2014) was a political scientist at the University of Hawaiʻi who spent four decades quantifying government-sponsored killing. He is credited with coining the term <em>democide</em> and with producing the most comprehensive statistical record of mass murder by states in the modern era. His major works — <em>Death by Government</em>, <em>Statistics of Democide</em>, <em>China's Bloody Century</em>, and <em>Lethal Politics</em> — form the corpus this archive preserves.`,
		itemIds: [
			'death-by-government',
			'statistics-of-democide-note',
			'chinas-bloody-century-note',
			'lethal-politics-note',
		],
	},
	{
		num: '02',
		slug: 'o-que-e-democidio',
		title: 'O Que É Democídio',
		subtitle: 'Defining the term',
		body: `Rummel defined democide as <em>"the murder of any person or people by their government, including genocide, politicide, and mass murder."</em> The definition was designed to capture state killing that falls outside combat — executions, engineered famines, forced-labour deaths, and deliberate civilian targeting. The distinction from genocide matters: democide does not require intent to destroy a group as such, only that the government intentionally kills. This broader frame revealed a category of political violence that had been systematically undercounted.`,
		itemIds: [
			'definition-and-qualifications',
			'democide-versus-genocide',
			'what-is-genocide',
			'death-by-government-chapter-1',
		],
	},
	{
		num: '03',
		slug: 'a-escala',
		title: 'A Escala',
		subtitle: 'The magnitude of the finding',
		body: `Rummel's headline finding is that governments killed approximately <strong>262&nbsp;million people</strong> in the 20th century — nearly four times the death toll of all the century's wars combined. He termed regimes that killed over a million people "megamurderers." The Soviet Union leads his estimates at roughly 62&nbsp;million; Nationalist and Communist China follow; Nazi Germany, Imperial Japan, and Nationalist China form the next tier. The remainder — dozens of smaller regimes — account for tens of millions more.`,
		itemIds: [
			'20th-century-democide',
			'war-isnt-this-centurys-biggest-killer',
			'death-by-government-chapter-1',
			'democide-summary-by-regime-table',
		],
	},
	{
		num: '04',
		slug: 'os-casos',
		title: 'Os Casos',
		subtitle: 'Regime by regime',
		body: `Rummel produced detailed statistical case studies for dozens of regimes, presenting primary source estimates, his own calculations, and consolidated ranges with full documentation. The studies range from the megamurderers to lesser-known colonial and wartime democides that rarely appear in mainstream historiography. Each chapter follows the same method — allowing direct comparison across cases that are otherwise treated in isolation.`,
		itemIds: [
			'how-many-did-communism-murder',
			'american-bombing-and-other-democide',
			'holocaust-in-comparative-perspective',
			'reevaluating-chinas-democide',
			'reevaluating-colonial-democide',
			'centi-kilo-murderers',
			'lesser-murderers',
			'khmer-rouge-and-rwandan-genocide-section',
		],
	},
	{
		num: '05',
		slug: 'a-analise',
		title: 'A Análise',
		subtitle: 'What the data shows',
		body: `Rummel analysed democide statistically, treating it as a dependent variable alongside political systems, economic development, cultural diversity, and military conflict. The consistent finding across dozens of analyses: political power — specifically its concentration and lack of constraint — is the dominant predictor of democide. War correlates with democide but does not cause it independently of power. The social field analyses formalise this relationship with factor analyses, canonical correlations, and regression models.`,
		itemIds: [
			'social-field-of-democide',
			'democide-since-world-war-ii',
			'statistics-of-democide-notes',
			'statistics-of-democide-sources',
		],
	},
	{
		num: '06',
		slug: 'a-tese',
		title: 'A Tese',
		subtitle: 'Power kills — and what follows from that',
		body: `The core argument Rummel derived from his data is captured in the phrase <em>"power kills; absolute power kills absolutely."</em> Democratically governed states — where power is constrained, checked, and accountable — virtually never commit democide against their own people. Rummel argued this was the most robust finding in his research and the most actionable conclusion: spreading democracy and limiting state power is the most effective prevention of mass murder. This is what he called the "miracle" — that the solution was already known.`,
		itemIds: [
			'murder',
			'miracle',
			'theory',
			'policy',
			'democide-versus-genocide',
		],
	},
];
---

<Layout title="Reading Guide | 20th Century Democide" description="A guided path through R.J. Rummel's democide research, from biography to central thesis.">

	<header class="guide-header">
		<a href={toBase()} class="back-link">← Home</a>
		<p class="kicker">Reading Guide</p>
		<h1>Six chapters through Rummel's work</h1>
		<p class="guide-intro">
			This guide takes you from Rummel's biography through his central thesis, in order. Each
			section links to the original preserved texts. Read the context here, then follow the
			links to the primary sources.
		</p>
		<nav class="guide-toc">
			{sections.map((s) => (
				<a href={`#${s.slug}`} class="toc-item">
					<span class="toc-num">{s.num}</span>
					<span class="toc-title">{s.title}</span>
				</a>
			))}
		</nav>
	</header>

	<div class="guide-body">
		{sections.map((section) => {
			const linkedItems = section.itemIds.map(getItem).filter(Boolean);
			return (
				<section class="guide-section" id={section.slug}>
					<div class="section-header">
						<span class="section-num">{section.num}</span>
						<div>
							<h2 class="section-title">{section.title}</h2>
							<p class="section-subtitle">{section.subtitle}</p>
						</div>
					</div>
					<div class="section-body">
						<div class="section-text" set:html={section.body} />
						{linkedItems.length > 0 && (
							<div class="section-links">
								<p class="links-label kicker">Primary sources</p>
								<ul class="source-list">
									{linkedItems.map((item) => item && (
										<li>
											<a href={toBase(`items/${item.id}/`)}>{item.title}</a>
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</section>
			);
		})}
	</div>

	<div class="guide-footer">
		<p>All texts linked above are preserved copies of Rummel's original work. Nothing has been edited or interpreted beyond what appears on this page.</p>
		<a href={toBase('collections/')}>Browse all collections →</a>
	</div>

</Layout>

<style>
	/* ── Guide header ─────────────────────────────────── */

	.guide-header {
		padding-bottom: 2.5rem;
		margin-bottom: 0;
		border-bottom: 1px solid var(--rule-strong);
	}

	.back-link {
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		text-decoration: none;
		display: inline-block;
		margin-bottom: 1.5rem;
	}

	.back-link:hover { color: var(--accent); }

	h1 {
		font-family: var(--display);
		font-size: clamp(1.8rem, 5vw, 3rem);
		font-weight: 900;
		font-style: italic;
		margin: 0.2rem 0 0.9rem;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.guide-intro {
		max-width: 58ch;
		color: var(--muted);
		line-height: 1.7;
		margin: 0 0 2rem;
		font-size: 1rem;
	}

	/* ── Table of contents ───────────────────────────── */

	.guide-toc {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.toc-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.85rem 0.4rem 0.6rem;
		border: 1px solid var(--rule-strong);
		border-radius: 2px;
		text-decoration: none;
		background: rgba(255, 252, 240, 0.8);
		transition: background 0.12s, border-color 0.12s;
	}

	.toc-item:hover {
		background: var(--accent-pale);
		border-color: var(--accent);
	}

	.toc-num {
		font-family: var(--mono);
		font-size: 0.6rem;
		color: var(--faint);
		letter-spacing: 0.05em;
	}

	.toc-title {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--ink);
	}

	/* ── Sections ────────────────────────────────────── */

	.guide-body {
		border-left: 1px solid var(--rule);
		margin-left: 1.5rem;
	}

	.guide-section {
		display: grid;
		grid-template-columns: 1fr;
		padding: 3rem 0 3rem 2.5rem;
		border-bottom: 1px solid var(--rule);
		position: relative;
	}

	/* connecting dot */
	.guide-section::before {
		content: '';
		position: absolute;
		left: -5px;
		top: 3.4rem;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--rule-strong);
	}

	.guide-section:first-child::before {
		border-color: var(--accent);
		background: var(--accent);
	}

	.guide-section:last-child {
		border-bottom: none;
	}

	.section-header {
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.section-num {
		font-family: var(--mono);
		font-size: 0.65rem;
		color: var(--faint);
		letter-spacing: 0.08em;
		padding-top: 0.35rem;
		flex-shrink: 0;
		min-width: 1.5rem;
	}

	.section-title {
		font-family: var(--display);
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.2rem;
		color: var(--ink);
		line-height: 1.2;
	}

	.section-subtitle {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--faint);
		letter-spacing: 0.04em;
	}

	.section-body {
		display: grid;
		grid-template-columns: 1fr 220px;
		gap: 2.5rem;
		align-items: start;
	}

	.section-text {
		font-size: 1.05rem;
		line-height: 1.78;
		color: var(--ink);
	}

	.section-text strong {
		font-weight: 600;
	}

	.section-text em {
		font-style: italic;
	}

	/* ── Source links ────────────────────────────────── */

	.section-links {
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--rule-strong);
		border-radius: 3px;
		background: rgba(255, 252, 240, 0.85);
		position: sticky;
		top: 1.5rem;
	}

	.links-label {
		margin-bottom: 0.6rem;
	}

	.source-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.source-list li {
		border-bottom: 1px solid var(--rule);
		padding: 0.4rem 0;
	}

	.source-list li:last-child {
		border-bottom: none;
	}

	.source-list a {
		font-size: 0.85rem;
		color: var(--muted);
		text-decoration: none;
		line-height: 1.45;
		display: block;
	}

	.source-list a:hover {
		color: var(--accent);
	}

	/* ── Footer ──────────────────────────────────────── */

	.guide-footer {
		padding: 2rem 0 1rem;
		border-top: 1px solid var(--rule);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	.guide-footer p {
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--faint);
		letter-spacing: 0.02em;
		line-height: 1.55;
		max-width: 55ch;
		margin: 0;
	}

	.guide-footer a {
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		text-decoration: none;
		flex-shrink: 0;
	}

	.guide-footer a:hover { color: var(--accent); }

	/* ── Responsive ──────────────────────────────────── */

	@media (max-width: 720px) {
		.guide-body { margin-left: 0; border-left: none; }

		.guide-section {
			padding: 2rem 0;
			border-left: none;
		}

		.guide-section::before { display: none; }

		.section-body {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.section-links { position: static; }
	}
</style>

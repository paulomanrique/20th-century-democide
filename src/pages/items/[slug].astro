---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { displayTitle } from '../../lib/title';

export async function getStaticPaths() {
	const items = await getCollection('items', ({ data }) => !data.draft);
	return items.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const collectionEntries = await getCollection('collections');
const collectionEntry = collectionEntries.find(
	(candidate) => candidate.data.collectionId === entry.data.collection,
);
const siblingItems = (await getCollection('items', ({ data }) => !data.draft))
	.filter(
		(candidate) =>
			candidate.data.collection === entry.data.collection && candidate.id !== entry.id,
	)
	.sort((a, b) => a.data.title.localeCompare(b.data.title))
	.slice(0, 10);
const toBase = (target = '') => `${import.meta.env.BASE_URL}${target.replace(/^\/+/, '')}`;
---

<Layout title={`${displayTitle(entry.data.title, entry.id)} | 20th Century Democide`}>

	<!-- Breadcrumb -->
	<nav class="breadcrumb">
		{
			collectionEntry ? (
				<>
					<a href={toBase('collections/')}>Collections</a>
					<span class="sep">›</span>
					<a href={toBase(`collections/${collectionEntry.id}/`)}>{collectionEntry.data.title}</a>
				</>
			) : (
				<a href={toBase('collections/')}>Collections</a>
			)
		}
	</nav>

	<!-- Article header -->
	<header class="article-header">
		<div class="article-meta-top">
			<span class="badge">{entry.data.sourceType}</span>
			<span class="badge">{entry.data.originalFormat}</span>
			{entry.data.firstPublished && <span class="badge">{entry.data.firstPublished}</span>}
		</div>
		<h1 class="article-title">{displayTitle(entry.data.title, entry.id)}</h1>
	</header>

	<!-- Article body -->
	<div class="article-body">
		<div class="article-content">
			<article class="prose">
				<Content />
			</article>

			{
				entry.data.editorialNotes.length > 0 && (
					<aside class="editorial-notes">
						<p class="kicker">Editorial notes</p>
						<ul>
							{entry.data.editorialNotes.map((note) => <li>{note}</li>)}
						</ul>
					</aside>
				)
			}

			<!-- Provenance collapsible -->
			<details class="provenance">
				<summary>
					<span class="kicker">Provenance &amp; capture metadata</span>
					<span class="prov-toggle-hint">click to expand</span>
				</summary>
				<div class="prov-body">
					<table>
						<tbody>
							<tr><th>Item ID</th><td><code>{entry.data.itemId}</code></td></tr>
							<tr><th>Original URL</th><td><a href={entry.data.originalUrl}>{entry.data.originalUrl}</a></td></tr>
							<tr><th>Source used</th><td><a href={entry.data.sourceUsed}>{entry.data.sourceUsed}</a></td></tr>
							<tr><th>Source type</th><td>{entry.data.sourceType}</td></tr>
							<tr><th>Capture date</th><td>{entry.data.captureDate}</td></tr>
							<tr><th>Original format</th><td>{entry.data.originalFormat}</td></tr>
							<tr><th>Translation status</th><td>{entry.data.translationStatus}</td></tr>
							<tr><th>Source record</th><td>{entry.data.provenance.sourceId}</td></tr>
							<tr><th>Raw path</th><td><code>{entry.data.provenance.rawPath}</code></td></tr>
							<tr><th>SHA-256</th><td><code class="hash">{entry.data.provenance.hash}</code></td></tr>
						</tbody>
					</table>
				</div>
			</details>
		</div>

		<!-- Sidebar -->
		{
			(collectionEntry || siblingItems.length > 0) && (
				<aside class="article-sidebar">
					{collectionEntry && (
						<div class="sidebar-section">
							<p class="kicker">Collection</p>
							<a class="sidebar-coll-title" href={toBase(`collections/${collectionEntry.id}/`)}>
								{collectionEntry.data.title}
							</a>
						</div>
					)}
					{siblingItems.length > 0 && (
						<div class="sidebar-section">
							<p class="kicker">More in this collection</p>
							<ul class="sidebar-links">
								{siblingItems.map((item) => (
									<li>
										<a href={toBase(`items/${item.id}/`)}>{displayTitle(item.data.title, item.id)}</a>
									</li>
								))}
							</ul>
						</div>
					)}
					<div class="sidebar-section">
						<a href={entry.data.originalUrl} class="source-link" target="_blank" rel="noopener noreferrer">
							View original source →
						</a>
					</div>
				</aside>
			)
		}
	</div>
</Layout>

<style>
	/* ── Breadcrumb ──────────────────────────────────── */

	.breadcrumb {
		font-family: var(--mono);
		font-size: 0.68rem;
		color: var(--faint);
		letter-spacing: 0.03em;
		margin-bottom: 1.75rem;
	}

	.breadcrumb a {
		color: var(--muted);
		text-decoration: none;
	}

	.breadcrumb a:hover { color: var(--accent); }

	.sep {
		margin: 0 0.45em;
		color: var(--rule-strong);
	}

	/* ── Article header ──────────────────────────────── */

	.article-header {
		margin-bottom: 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--rule-strong);
	}

	.article-meta-top {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1rem;
	}

	.article-title {
		font-family: var(--display);
		font-size: clamp(1.9rem, 5vw, 3rem);
		font-weight: 900;
		line-height: 1.1;
		margin: 0;
		color: var(--ink);
		letter-spacing: -0.01em;
	}

	/* ── Article body layout ─────────────────────────── */

	.article-body {
		display: grid;
		grid-template-columns: 1fr 220px;
		gap: 4rem;
		align-items: start;
	}

	.article-content {
		min-width: 0;
	}

	/* ── Prose ───────────────────────────────────────── */

	.prose {
		margin-bottom: 2.5rem;
	}

	/* ── Editorial notes ─────────────────────────────── */

	.editorial-notes {
		margin-bottom: 2rem;
		padding: 1rem 1.25rem;
		border-left: 3px solid var(--accent);
		background: var(--accent-pale);
		font-size: 0.9rem;
		color: var(--muted);
	}

	.editorial-notes .kicker { margin-bottom: 0.5rem; }

	.editorial-notes ul {
		margin: 0;
		padding-left: 1.25em;
	}

	.editorial-notes li { line-height: 1.6; }

	/* ── Provenance ──────────────────────────────────── */

	.provenance {
		border: 1px solid var(--rule-strong);
		border-radius: 3px;
		overflow: hidden;
	}

	.provenance summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 1.25rem;
		cursor: pointer;
		list-style: none;
		user-select: none;
		background: rgba(255, 252, 240, 0.7);
	}

	.provenance summary::-webkit-details-marker { display: none; }
	.provenance summary .kicker { margin: 0; }

	.prov-toggle-hint {
		font-family: var(--mono);
		font-size: 0.62rem;
		color: var(--faint);
		letter-spacing: 0.04em;
	}

	.provenance[open] .prov-toggle-hint { display: none; }

	.prov-body {
		padding: 0 1.25rem 1.25rem;
		border-top: 1px solid var(--rule);
	}

	.prov-body table { font-size: 0.8rem; margin-top: 0.75rem; }

	.prov-body th {
		width: 120px;
		padding: 0.4rem 0.75rem 0.4rem 0;
		white-space: nowrap;
		vertical-align: top;
	}

	.prov-body td { padding: 0.4rem 0; word-break: break-all; }

	.hash { font-size: 0.72em; }

	/* ── Sidebar ─────────────────────────────────────── */

	.article-sidebar {
		position: sticky;
		top: 2rem;
	}

	.sidebar-section {
		margin-bottom: 2rem;
	}

	.sidebar-section .kicker {
		margin-bottom: 0.6rem;
	}

	.sidebar-coll-title {
		font-family: var(--display);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--ink);
		text-decoration: none;
		line-height: 1.3;
		display: block;
	}

	.sidebar-coll-title:hover { color: var(--accent); }

	.sidebar-links {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--rule);
	}

	.sidebar-links li {
		border-bottom: 1px solid var(--rule);
	}

	.sidebar-links a {
		display: block;
		padding: 0.4rem 0;
		font-size: 0.85rem;
		color: var(--muted);
		text-decoration: none;
		line-height: 1.4;
	}

	.sidebar-links a:hover { color: var(--accent); }

	.source-link {
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.03em;
		color: var(--muted);
		text-decoration: none;
	}

	.source-link:hover { color: var(--accent); }

	/* ── Responsive ──────────────────────────────────── */

	@media (max-width: 860px) {
		.article-body {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.article-sidebar {
			position: static;
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
			gap: 1.25rem;
		}

		.sidebar-section { margin-bottom: 0; }
	}
</style>

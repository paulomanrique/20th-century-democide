---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import YAML from 'yaml';
import Layout from '../layouts/Layout.astro';

interface ManifestItem {
	item_id: string;
	capture_status: string;
	translation_status?: string;
}

const items = (YAML.parse(
	fs.readFileSync(path.join(process.cwd(), 'data', 'manifests', 'items.yaml'), 'utf8'),
) ?? []) as ManifestItem[];

const byStatus = items.reduce<Record<string, number>>((acc, item) => {
	acc[item.capture_status] = (acc[item.capture_status] ?? 0) + 1;
	return acc;
}, {});

const publishedCount = byStatus.published ?? 0;
const completion = items.length === 0 ? 0 : Math.round((publishedCount / items.length) * 100);

const toBase = (target = '') => `${import.meta.env.BASE_URL}${target.replace(/^\/+/, '')}`;
---

<Layout title="Archive | 20th Century Democide" description="Preservation status, sources, and project information.">

	<header class="page-header">
		<a href={toBase()} class="back-link">← Home</a>
		<p class="kicker">Preservation Archive</p>
		<h1>Archive</h1>
		<p class="page-intro">
			Technical information about the preservation project: capture status, source
			priorities, contribution guidelines, and rights.
		</p>
	</header>

	<!-- Status strip -->
	<div class="status-strip">
		<div class="status-item">
			<span class="status-num">{items.length}</span>
			<span class="status-label">indexed items</span>
		</div>
		<div class="status-item">
			<span class="status-num">{publishedCount}</span>
			<span class="status-label">published</span>
		</div>
		<div class="status-item">
			<span class="status-num">{completion}%</span>
			<span class="status-label">of founder slice</span>
		</div>
		<div class="progress-wrap">
			<div class="progress">
				<span style={`width: ${completion}%`}></span>
			</div>
		</div>
	</div>

	<!-- Links -->
	<nav class="archive-nav">
		<a href={toBase('dashboard/')} class="archive-link">
			<span class="archive-link-title">Preservation Dashboard</span>
			<span class="archive-link-desc">Full item inventory with capture status, types, and collection breakdown.</span>
			<span class="archive-link-arrow">→</span>
		</a>
		<a href={toBase('sources/')} class="archive-link">
			<span class="archive-link-title">Capture Sources</span>
			<span class="archive-link-desc">Ordered list of sources used for capture: originals, mirrors, and Wayback snapshots.</span>
			<span class="archive-link-arrow">→</span>
		</a>
		<a href={toBase('contributing/')} class="archive-link">
			<span class="archive-link-title">Contributing</span>
			<span class="archive-link-desc">How to report errors, add items, and follow the editorial policy.</span>
			<span class="archive-link-arrow">→</span>
		</a>
		<a href={toBase('rights/')} class="archive-link">
			<span class="archive-link-title">Rights & Attribution</span>
			<span class="archive-link-desc">Repository code licence and rights status of preserved source material.</span>
			<span class="archive-link-arrow">→</span>
		</a>
	</nav>

	<!-- Pipeline note -->
	<div class="pipeline-note">
		<p class="kicker">How preservation works</p>
		<p>
			The tooling prefers originals at <code>hawaii.edu/powerkills</code>, then
			authorial mirrors, then Wayback snapshots. Raw HTML captures, SHA-256 checksums,
			normalized Markdown, and local asset copies are all kept in the repository. Each
			item carries a full provenance record linking back to its capture source.
		</p>
	</div>

</Layout>

<style>
	.page-header {
		margin-bottom: 2.5rem;
	}

	.back-link {
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		text-decoration: none;
		display: inline-block;
		margin-bottom: 1.5rem;
	}

	.back-link:hover { color: var(--accent); }

	h1 {
		font-family: var(--display);
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 900;
		font-style: italic;
		margin: 0.2rem 0 0.75rem;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.page-intro {
		max-width: 52ch;
		color: var(--muted);
		line-height: 1.65;
		margin: 0;
		font-size: 1rem;
	}

	/* ── Status strip ─────────────────────────────────── */

	.status-strip {
		display: flex;
		align-items: center;
		gap: 2.5rem;
		padding: 1.25rem 1.75rem;
		border: 1px solid var(--rule-strong);
		border-radius: 3px;
		background: rgba(255, 252, 240, 0.85);
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.status-item {
		display: flex;
		flex-direction: column;
	}

	.status-num {
		font-family: var(--display);
		font-size: 1.8rem;
		font-weight: 900;
		line-height: 1;
		color: var(--ink);
	}

	.status-label {
		font-family: var(--mono);
		font-size: 0.62rem;
		color: var(--faint);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin-top: 0.2rem;
	}

	.progress-wrap {
		flex: 1;
		min-width: 120px;
	}

	.progress {
		height: 3px;
		border-radius: 99px;
		background: var(--rule);
		overflow: hidden;
	}

	.progress > span {
		display: block;
		height: 100%;
		background: var(--accent);
	}

	/* ── Archive nav ─────────────────────────────────── */

	.archive-nav {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--rule-strong);
		border-radius: 3px;
		overflow: hidden;
		margin-bottom: 2.5rem;
	}

	.archive-link {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: auto auto;
		gap: 0.2rem 1rem;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid var(--rule);
		background: rgba(255, 252, 240, 0.85);
		text-decoration: none;
		color: inherit;
		transition: background 0.12s;
	}

	.archive-link:last-child { border-bottom: none; }
	.archive-link:hover { background: var(--accent-pale); }

	.archive-link-title {
		font-family: var(--display);
		font-size: 1rem;
		font-weight: 700;
		color: var(--ink);
		grid-column: 1;
		grid-row: 1;
	}

	.archive-link:hover .archive-link-title { color: var(--accent); }

	.archive-link-desc {
		font-size: 0.88rem;
		color: var(--muted);
		line-height: 1.5;
		grid-column: 1;
		grid-row: 2;
	}

	.archive-link-arrow {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--faint);
		grid-column: 2;
		grid-row: 1 / 3;
		align-self: center;
		transition: transform 0.12s, color 0.12s;
	}

	.archive-link:hover .archive-link-arrow {
		transform: translateX(3px);
		color: var(--accent);
	}

	/* ── Pipeline note ───────────────────────────────── */

	.pipeline-note {
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--rule);
		border-radius: 3px;
		background: rgba(255, 252, 240, 0.5);
	}

	.pipeline-note .kicker { margin-bottom: 0.6rem; }

	.pipeline-note p:last-child {
		margin: 0;
		font-size: 0.92rem;
		color: var(--muted);
		line-height: 1.7;
	}
</style>
